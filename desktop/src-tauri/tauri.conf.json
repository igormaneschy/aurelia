{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurelia",
  "version": "0.1.0",
  "identifier": "com.aurelia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aurelia",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "x": 80,
        "y": 80,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Cliente desktop do Aurelia",
    "longDescription": "Cliente desktop local para o daemon Aurelia via Unix socket.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
